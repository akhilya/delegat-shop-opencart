# Public origin of this shop (trailing slash required).
# Local default matches PUBLISH_PORT. On Dokploy use https://oc.your.domain/
SITE_URL=http://localhost:8089/

# GHCR image tag (CI publishes latest on main, semver on v* tags).
SHOP_IMAGE_TAG=latest

# Host port mapped to container 80.
# On Dokploy leave as a high unused port; Traefik still targets container 80.
# Do not set this to 80 (conflicts with Dokploy Traefik).
PUBLISH_PORT=8089

MYSQL_DATABASE=opencart
MYSQL_USER=opencart
MYSQL_PASSWORD=opencart
MYSQL_ROOT_PASSWORD=opencart

OPENCART_USERNAME=admin
OPENCART_PASSWORD=admin
OPENCART_EMAIL=admin@example.com

# Paste this key into the Delegat workspace connection.
BRIDGE_API_KEY=delegat-oc-sandbox-api-key-local
