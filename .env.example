# Shop address in the browser. Slash at the end is required.
# Local: http://localhost:8089/
# Server: https://oc.your.domain/
SITE_URL=http://localhost:8089/

# Image version. Leave as latest unless you pin a release.
SHOP_IMAGE_TAG=latest

# Port on your computer. Not 80 on a Dokploy server.
PUBLISH_PORT=8089

MYSQL_DATABASE=opencart
MYSQL_USER=opencart
MYSQL_PASSWORD=opencart
MYSQL_ROOT_PASSWORD=opencart

OPENCART_USERNAME=admin
OPENCART_PASSWORD=admin
OPENCART_EMAIL=admin@example.com

# Paste this key into the Delegat workspace connection.
BRIDGE_API_KEY=delegat-oc-sandbox-api-key-local
